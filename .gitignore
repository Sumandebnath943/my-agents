node_modules/
.env
*.local

# Private financial screenshots (finance-agent training data) — never publish
Payment Messages Training/

# CV / resume. agents/job-agent/index.js documents cv.md as a local fallback for the CV_TEXT
# secret, which makes it easy to drop a real CV here by accident — into a PUBLIC repo. The resume
# PDF lives in the private Supabase bucket (scripts/upload-resume.mjs); nothing goes here.
agents/job-agent/cv.md
*resume*.pdf
*resume*.docx
*Resume*.pdf
*Resume*.docx

# Local project docs — keep out of the public repo.
# Wildcards, not exact names: an archived/backup copy (e.g. PORTFOLIO_UPDATE_HANDOFF.previous-*.md)
# would otherwise slip past an exact-match rule and get committed to a PUBLIC repo.
HANDOFF*.md
PROJECT_BIBLE*.md
PORTFOLIO_HANDOFF*.md
PORTFOLIO_UPDATE_HANDOFF*.md
MAS_SETUP*.md
ECHO_SETUP*.md

# Security posture record. Documents which protections are ON *and which are OFF*, which is
# exactly the reconnaissance a public repo shouldn't hand out. Stays local.
SECURITY_POSTURE*.md

# Published-artifact source (claude.ai/code/artifact/e694b8af). Generated, not fleet code, and
# the timetable now lives at /dashboard/timetable — kept locally so the artifact can be republished.
fleet-timetable.html

# Dispatcher planning records — internal operational detail (Vercel/Supabase usage, schedules).
# Same reason as PROJECT_BIBLE/HANDOFF/SECURITY_POSTURE: this repo is public.
DISPATCHER_*.md

# Carousel rollback plan — internal operational detail (baseline commits, which flags gate what,
# what to pull first when it misbehaves). Same reason as DISPATCHER_*: this repo is public.
CAROUSEL_*.md

# LLM routing record — provider ceilings, per-agent token loads, which providers are dead or
# out of credit. That is a map of exactly where the fleet is fragile, plus billing state. Same
# reason as SECURITY_POSTURE: useful to us, reconnaissance to anyone else. Stays local.
LLM_ROUTING*.md
