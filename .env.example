GROQ_API_KEY=
GEMINI_API_KEY=
# OpenAI (PAID) — primary for heavy/quality/private agents; see lib/routing.js. Blank = the fleet
# runs entirely on the free providers below (fully fail-safe). MAS/ECHO use their own OpenAI keys.
OPENAI_API_KEY=
# Optional permanent-free failover providers (OpenAI-compatible). Leave blank to skip a provider —
# absent key = provider is silently skipped in the fallback chain, never an error.
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Optional 🟡-tier add-ons (metered free; tracked + degrade gracefully via lib/tier.js). Blank = off.
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
# COHERE_API_KEY lives in the DASHBOARD (Vercel) env — it powers ECHO rerank, not the fleet.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SUPABASE_URL=
SUPABASE_KEY=
RESEND_API_KEY=
RESEND_FROM=
MY_EMAIL=
# --- Security hardening (added by the 2026-07 audit) ---
# Must MATCH the dashboard's TOKEN_ENC_KEY — encrypts the LinkedIn token at rest so the fleet can
# read/refresh it. Blank = plaintext (unchanged behavior). Set in GitHub Actions secrets too.
TOKEN_ENC_KEY=
# MCP server (mcp/server.js) hardening — all optional, blank = off:
#   MCP_READONLY=1                     disable side-effecting tools (kv_set, telegram_send, dispatch, memory_remember)
#   MCP_QUERY_TABLES=kv,finance,...    restrict supabase_query to an allowlist ("sessions" is always blocked)
#   MCP_DISPATCH_WORKFLOWS=12-briefing.yml,...   restrict github_workflow_trigger to an allowlist
MCP_READONLY=
MCP_QUERY_TABLES=
MCP_DISPATCH_WORKFLOWS=
